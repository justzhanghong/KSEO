{
  "schema_version": 1,
  "draft": true,
  "name": "a800_long_context",
  "mode": "measured",
  "inputs": {
    "model": "<model-path>",
    "model_revision": "<weight-manifest-sha256>",
    "image": "<image@sha256:digest>",
    "workload": "<frozen-request-manifest>",
    "workload_sha256": "<sha256>",
    "servers": [
      "<host>"
    ]
  },
  "context": {
    "model_family": "<family>",
    "gpu_arch": "sm80",
    "backend": "vllm",
    "workload": "long_context",
    "capabilities": []
  },
  "source": {
    "kind": "git",
    "path": "<base-source>",
    "revision": "<full-commit>"
  },
  "parameters": {
    "max_num_batched_tokens": 8192,
    "max_num_seqs": 16
  },
  "steps": [
    {
      "name": "preflight",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 120
    },
    {
      "name": "build",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 3600
    },
    {
      "name": "deploy",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 1800
    },
    {
      "name": "smoke",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 300
    },
    {
      "name": "profile",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "benchmark",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 3600
    },
    {
      "name": "quality",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 7200
    },
    {
      "name": "api",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 1800
    },
    {
      "name": "stability",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_adapter.py"
      ],
      "timeout_seconds": 7200
    },
    {
      "name": "final_accuracy",
      "command": [
        "{python}",
        "{config_dir}/adapters/project_final_accuracy.py"
      ],
      "timeout_seconds": 86400
    }
  ],
  "cleanup": {
    "command": [
      "{python}",
      "{config_dir}/adapters/project_adapter.py"
    ],
    "timeout_seconds": 180
  },
  "validation": {
    "zero_cache_reads": true,
    "quality_samples": 1319,
    "cases": [
      {
        "id": "long_c1",
        "requests": 5,
        "input_tokens": 49891,
        "output_tokens": 256
      }
    ],
    "gates": [
      {
        "name": "GPU 架构核对",
        "stage": "preflight",
        "field": "preflight.runtime.gpu_arch",
        "op": "==",
        "value": "sm80"
      },
      {
        "name": "GPU UUID 核对",
        "stage": "preflight",
        "field": "preflight.checks.gpu_identity_match",
        "op": "==",
        "value": true
      },
      {
        "name": "实际镜像核对",
        "stage": "preflight",
        "field": "preflight.checks.image_identity_match",
        "op": "==",
        "value": true
      },
      {
        "name": "实际源码核对",
        "stage": "smoke",
        "field": "smoke.checks.source_identity_match",
        "op": "==",
        "value": true
      },
      {
        "name": "完整请求成功",
        "stage": "benchmark",
        "field": "benchmark.failed_requests",
        "op": "==",
        "value": 0
      },
      {
        "name": "TTFT 示例门槛",
        "stage": "benchmark",
        "field": "benchmark.cases.long_c1.ttft_ms.mean",
        "op": "<=",
        "value": 10000
      },
      {
        "name": "TPOT 示例门槛",
        "stage": "benchmark",
        "field": "benchmark.cases.long_c1.tpot_ms.mean",
        "op": "<=",
        "value": 30
      },
      {
        "name": "GSM8K 示例门槛",
        "stage": "quality",
        "field": "quality.accuracy",
        "op": ">=",
        "value": 0.95
      },
      {
        "name": "精度请求无失败",
        "stage": "quality",
        "field": "quality.failed_requests",
        "op": "==",
        "value": 0
      },
      {
        "name": "数值一致性",
        "stage": "quality",
        "field": "quality.checks.numerics",
        "op": "==",
        "value": true
      },
      {
        "name": "API 与请求隔离",
        "stage": "api",
        "field": "api.checks.contract_pass",
        "op": "==",
        "value": true
      },
      {
        "name": "稳定性验收",
        "stage": "stability",
        "field": "stability.checks.contract_pass",
        "op": "==",
        "value": true
      },
      {
        "name": "最终三项精度与有效性",
        "stage": "final_accuracy",
        "field": "final_accuracy.passed",
        "op": "==",
        "value": true
      }
    ],
    "objective": {
      "field": "benchmark.cases.long_c1.ttft_ms.mean",
      "direction": "min"
    },
    "final_accuracy": {
      "suites": [
        {
          "id": "rtlbench",
          "dataset_id": "rtlbench-160",
          "dataset_sha256": "6c18a1f74c0c4f4d480fae588dbd98ca94b74abf4c506c5b54855d857bebf0df",
          "expected_samples": 160,
          "manifest": [],
          "evaluator_sha256": "<actual-evaluator-sha256>",
          "extractor_sha256": "<actual-extractor-sha256>",
          "min_score": null,
          "max_failed_requests": 0,
          "generation": {
            "thinking": "<frozen-thinking-mode>",
            "first_max_output_tokens": null,
            "context_limit": null,
            "retry_policy": "none"
          }
        },
        {
          "id": "longbench_v2",
          "dataset_id": "longbench-v2",
          "dataset_sha256": "6330d1a0bc8b95b70393fea979e9fe9b19660460d9a067b9e2db35c36a7fd5b5",
          "expected_samples": 525,
          "manifest": [],
          "evaluator_sha256": "<actual-evaluator-sha256>",
          "extractor_sha256": "<actual-extractor-sha256>",
          "min_score": null,
          "max_failed_requests": 0,
          "generation": {
            "thinking": "<frozen-thinking-mode>",
            "first_max_output_tokens": null,
            "context_limit": null,
            "retry_policy": "none"
          },
          "choice_regex": "<freeze-final-content-choice-regex>"
        },
        {
          "id": "livecodebench_v1",
          "dataset_id": "livecodebench-v1",
          "dataset_sha256": "201ea799ca93484da54da18a63cd56b71ec215c17f2228b09088e2e5a1613beb",
          "expected_samples": 400,
          "manifest": [],
          "evaluator_sha256": "<actual-evaluator-sha256>",
          "extractor_sha256": "<actual-extractor-sha256>",
          "min_score": null,
          "max_failed_requests": 0,
          "generation": {
            "thinking": "<frozen-thinking-mode>",
            "first_max_output_tokens": null,
            "context_limit": null,
            "retry_policy": "none"
          }
        }
      ]
    }
  },
  "optimizer": {
    "kind": "pipeline",
    "space": {
      "max_num_batched_tokens": [
        4096,
        8192,
        16384
      ]
    },
    "min_relative_improvement": 0.005,
    "allow_source_changes": true,
    "max_cycles": 16,
    "max_config_trials": 4,
    "final_reserve_seconds": 7200,
    "scheduling": {
      "command": [
        "/path/to/scheduling-agent-wrapper"
      ],
      "timeout_seconds": 900,
      "allow_source_changes": true
    },
    "kernel": {
      "extractor": {
        "command": [
          "{python}",
          "{config_dir}/adapters/kernel_extract.py"
        ],
        "timeout_seconds": 900
      },
      "proposer": {
        "command": [
          "/path/to/kernel-agent-wrapper"
        ],
        "timeout_seconds": 1800,
        "allow_source_changes": true
      },
      "validator": {
        "command": [
          "{python}",
          "{config_dir}/adapters/kernel_validate.py"
        ],
        "timeout_seconds": 900
      },
      "min_speedup": 1.01
    }
  },
  "budget": {
    "max_trials": 12,
    "max_wall_seconds": 86400,
    "max_gpu_hours": 192
  },
  "resources": {
    "gpu_count": 8,
    "keys": [
      "<host>:<GPU-UUID-0>",
      "<host>:<GPU-UUID-1>",
      "<host>:<GPU-UUID-2>",
      "<host>:<GPU-UUID-3>",
      "<host>:<GPU-UUID-4>",
      "<host>:<GPU-UUID-5>",
      "<host>:<GPU-UUID-6>",
      "<host>:<GPU-UUID-7>"
    ],
    "lock_dir": "<shared-lock-directory>"
  },
  "final_validation": true,
  "notes": "GEAK 思路下的分层流水线草稿。配置 sweep 有独立预算；System 按当前 Profile 调用 Scheduling/Kernel，所有候选仍需 E2E 验收。请接入真实 adapter 后再启用。"
}
